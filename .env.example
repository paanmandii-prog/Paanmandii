# ==============================================================
# PAAN MANDI — Environment Variables Template
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to version control.
# ==============================================================

# ==============================================================
# SUPABASE (Required)
# Get these from: Supabase Dashboard → Project Settings → API
# ==============================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Service role key — NEVER expose in frontend code
# Used only in server-side API routes and webhooks
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ==============================================================
# RAZORPAY (Optional — required only for online payments)
# Get these from: https://dashboard.razorpay.com/app/keys
# Leave blank to disable online payments (COD/Pay-at-Shop still work)
# ==============================================================
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# For client-side payment initialization (safe to expose)
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# ==============================================================
# EMAIL NOTIFICATIONS (Optional)
# Supported: Resend (recommended), SendGrid, SMTP
# ==============================================================
# Option A: Resend (https://resend.com)
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@yourdomain.com

# Option B: SendGrid
# SENDGRID_API_KEY=
# SENDGRID_FROM_EMAIL=noreply@yourdomain.com

# Option C: SMTP
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# ==============================================================
# SMS / WHATSAPP NOTIFICATIONS (Optional)
# Supported: Twilio (SMS), Gupshup / 2Factor (WhatsApp)
# ==============================================================
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# WhatsApp (Gupshup or similar authorized BSP)
# WHATSAPP_API_KEY=
# WHATSAPP_FROM_NUMBER=

# ==============================================================
# APPLICATION CONFIG
# ==============================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=PAAN MANDI
NODE_ENV=development

# Set to 'true' to enable detailed server-side logging
# Set to 'false' in production
DEBUG_LOGGING=true

# ==============================================================
# SUPABASE STORAGE (configured automatically via Supabase project)
# The bucket names below are created by the setup script
# ==============================================================
NEXT_PUBLIC_STORAGE_BUCKET_PRODUCTS=product-images
NEXT_PUBLIC_STORAGE_BUCKET_AVATARS=avatars

# ==============================================================
# RATE LIMITING (Optional — uses Upstash Redis if configured)
# ==============================================================
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ==============================================================
# ADMIN SETUP (set temporarily when running admin provisioning)
# Remove after use
# ==============================================================
# FIRST_ADMIN_EMAIL=admin@example.com
